# Server Configuration
PORT=4000

# Database
MONGO_URI=mongodb://localhost:27017/MVEC

# Security / JWT
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration (Nodemailer / Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password

# Phone OTP Verification
# Leave SMS_PROVIDER empty/log to print the code to the server console (dev).
# Plug a real gateway later (e.g. Twilio) by implementing the adapter in
# src/utils/sms.util.js — the controller code does not need to change.
SMS_PROVIDER=log
SMS_FROM_NAME=MVEC
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Mobile Money (MoMo / Airtel) Gateway
# In non-production the gateway runs in sandbox mode (simulated USSD push) and
# no real credentials are required. Set these in production to use a live API.
MOMO_GATEWAY_BASE_URL=
MOMO_GATEWAY_SUB_KEY=
MOMO_GATEWAY_AUTH=
# Shared secrets used to verify inbound webhook signatures (HMAC-SHA256).
MOMO_WEBHOOK_SECRET=change_me_momo_webhook_secret
AIRTEL_WEBHOOK_SECRET=change_me_airtel_webhook_secret