# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/MVEC?replicaSet=rs0&directConnection=true

# Security / JWT
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration (Nodemailer / Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM=
EMAIL_SERVICE=Gmail
# Set EMAIL_HOST to use a custom SMTP server instead of EMAIL_SERVICE
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false

# Phone OTP Verification
# Leave SMS_PROVIDER empty/log to print the code to the server console (dev).
# Plug a real gateway later (e.g. Twilio) by implementing the adapter in
# src/utils/sms.util.js — the controller code does not need to change.
SMS_PROVIDER=log
SMS_FROM_NAME=MVEC
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Mobile Money (MoMo / Airtel) Gateway
# MTN MoMo OpenAPI (collection / request-to-pay)
MOMO_PRIMARY_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_BASE_URL=
MOMO_TARGET_ENV=sandbox
# Shared secrets used to verify inbound webhook signatures (HMAC-SHA256).
MOMO_WEBHOOK_SECRET=change_me_momo_webhook_secret
AIRTEL_WEBHOOK_SECRET=change_me_airtel_webhook_secret

# Airtel Money OpenAPI (sandbox: https://openapiuat.airtel.africa)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_SECRET_KEY=
AIRTEL_COUNTRY=RWA
AIRTEL_CURRENCY=RWF
# Airtel merchant gateway (payments are simulated when empty or not in production)
AIRTEL_GATEWAY_BASE_URL=
AIRTEL_GATEWAY_CLIENT_ID=
AIRTEL_GATEWAY_CLIENT_SECRET=

# Paypack (https://paypack.rw) - collects from MTN MoMo and Airtel Money numbers.
# Leave the client id/secret empty to simulate payments locally.
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_BASE_URL=https://payments.paypack.rw/api
# Secret from the Paypack dashboard webhook settings, used to verify X-Paypack-Signature.
PAYPACK_WEBHOOK_SECRET=
# "development" or "production": Paypack calls the webhook URL registered for this mode.
PAYPACK_WEBHOOK_MODE=development
